# Used by `npm run dev:emulator` — talks to the local Firebase emulators
# started with `npm run emulators`. Safe to commit: no real project involved.
VITE_FIREBASE_API_KEY=fake-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-job-tracker
VITE_FIREBASE_APP_ID=1:123:web:abc
VITE_USE_FIREBASE_EMULATOR=true
